# Boka tid — miljövariabler. Denna fil ska ALDRIG committas.
# Alla nycklar har prefixet BOKA_ av ett skäl: vibecoder-miljön har egna
# ADMIN_PASSWORD, SMTP_HOST och SMTP_PORT, och värdens miljövariabler vinner
# över .env vid interpolation i docker compose. Utan prefix får containern
# tysta, felaktiga värden.
BOKA_DB_PASSWORD=byt-mig-openssl-rand-hex-24
BOKA_SESSION_SECRET=byt-mig-openssl-rand-hex-32
# Nyckel för kryptering av M365-tokens i vila (AES-256-GCM, 32 byte hex)
BOKA_TOKEN_KEY=byt-mig-exakt-64-tecken-hex-openssl-rand-hex-32

# Lokal administratör (används tills M365-inloggning är på plats)
BOKA_ADMIN_EMAIL=namn@exempel.se
BOKA_ADMIN_NAME=Förnamn Efternamn
BOKA_ADMIN_SLUG=fornamn
BOKA_ADMIN_PASSWORD=byt-mig-minst-12-tecken

# Domäner vars användare får skapa konto själva via "Logga in med Microsoft".
# Kommaseparerat. Tomt = domänen i BOKA_ADMIN_EMAIL används.
BOKA_ALLOWED_EMAIL_DOMAINS=exempel.se

# Automatisk gallring, antal dagar. 0 stänger av gallringen för den kategorin.
BOKA_GALLRING_BOKNINGAR_DAGAR=90
BOKA_GALLRING_OMROSTNINGAR_DAGAR=90
BOKA_GALLRING_LOGG_DAGAR=365

# Hur ofta prenumererade kalendrar (externa parter) läses om, i minuter.
BOKA_FEED_INTERVALL_MINUTER=5

# Publik adress. Används i bokningslänkar och som OAuth-redirect.
BOKA_PUBLIC_URL=https://exempel.se/boka

# E-post. Använd en avsändardomän som er e-postserver signerar (DKIM) och som
# står i domänens SPF — annars hamnar bekräftelserna i skräpposten.
BOKA_SMTP_HOST=smtp.exempel.se
BOKA_SMTP_PORT=25
BOKA_SMTP_SENDER=noreply@exempel.se
BOKA_SMTP_SENDER_NAME=Din organisation
BOKA_SMTP_USER=
BOKA_SMTP_PASS=

# Microsoft 365 / Entra. Fylls i efter appregistrering, se docs/M365-KOPPLING.md
BOKA_MS_TENANT_ID=
BOKA_MS_CLIENT_ID=
BOKA_MS_CLIENT_SECRET=
